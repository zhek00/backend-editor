# Copie para deploy/.env e preencha. Este arquivo vai no Git; o .env de verdade nunca.

# --- servidor e domínios ---
API_DOMINIO=api.seudominio.com
MCP_DOMINIO=mcp.seudominio.com
POSTGRES_SENHA=troque-por-uma-senha-longa
# IP privado do servidor principal (rede interna do provedor): onde o banco escuta para os trabalhadores
POSTGRES_IP_PRIVADO=127.0.0.1
# nos trabalhadores de outras máquinas: o IP privado do principal
POSTGRES_HOST=10.0.0.2

# token do painel antigo (/api): fixe um valor longo, senão a fábrica cria outro a cada reinício
FABRICA_TOKEN=troque-por-um-token-longo

# --- quanto cada máquina produz ---
# vídeos ao mesmo tempo por máquina; renders e gravações de animação (Chrome) ao mesmo tempo, somando os vídeos
FABRICA_VAGAS=4
FABRICA_RENDERS=1
FABRICA_CHROMES=4

# --- entrega no Cloudflare R2 (crie um bucket com regra de ciclo de vida: apagar com mais de 3 dias) ---
FABRICA_R2_ENDPOINT=https://SEU_ID_DE_CONTA.r2.cloudflarestorage.com
FABRICA_R2_BUCKET=fabrica-videos
FABRICA_R2_ACCESS_KEY=
FABRICA_R2_SECRET_KEY=

# --- avisos (Discord, Slack...): crédito acabou, chave recusada, consumo alto ---
FABRICA_ALERTA_WEBHOOK=

# --- as chaves dos serviços: as mesmas do .env da fábrica de hoje (OpenRouter, Groq, Gemini, Jev, GenAIPro,
#     Pexels, Pixabay...). Copie-as daqui para baixo. ---
