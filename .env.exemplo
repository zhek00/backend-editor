# Copie este arquivo para .env e cole suas chaves. Nunca compartilhe o .env.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Grátis, para fotos e vídeos reais. Crie em pexels.com/api e em pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Avatar falante pelo DreamFace. Crie em api.newportai.com
DREAMAPI_KEY=

# Opcionais. Só preencha se mudar o provedor de imagens para fal ou kie,
# ou claude.via para api no config.yaml. Edge TTS (voz gratuita) não precisa de chave.
FAL_KEY=
KIE_API_KEY=
ANTHROPIC_API_KEY=
