# Copie este arquivo para .env e cole suas chaves. Nunca compartilhe o .env.
# A narração não precisa de chave: são as vozes open source que rodam dentro da fábrica (motores_voz/).

# Obrigatórias
# OpenRouter: imagens de IA, o Jev (juiz das cenas) e os modelos de reserva. Crie em openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq: grátis, é o primeiro modelo de toda cadeia. Crie em console.groq.com/keys.
# Pode pôr várias (GROQ_API_KEY1, GROQ_API_KEY2...): cada uma tem o próprio limite por dia.
GROQ_API_KEY=
# Google: descreve as imagens para o Jev. Crie em aistudio.google.com/apikey
GEMINI_API_KEY=
# Grátis, para fotos e vídeos reais. Crie em pexels.com/api e em pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcionais: mais bancos de imagem. Sem a chave, o banco se desliga sozinho e a fábrica segue com os outros.
UNSPLASH_ACCESS_KEY=
HARVARD_API_KEY=
EUROPEANA_API_KEY=
SMITHSONIAN_API_KEY=
NYPL_API_KEY=
TEPAPA_API_KEY=
# Mais vídeos de banco. A chave se pede por e-mail a team@coverr.co (veja a licença antes de usar)
COVERR_API_KEY=

# Opcional: publicar no YouTube pelo editor (OAuth do Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: busca de canais e nichos no YouTube (fabrica/nichos.py)
YOUTUBE_API_KEY=

# Opcional: efeitos sonoros, música e voz por descrição pela ElevenLabs direta
ELEVENLABS_API_KEY=
# Opcional: avatar falante pelo DreamFace (api.newportai.com)
DREAMAPI_KEY=
# Opcional: imagens pela Kie, se o perfil trocar o provedor de imagens para kie
KIE_API_KEY=
ANTHROPIC_API_KEY=

# A senha do editor (FABRICA_TOKEN) é criada sozinha na primeira vez que o servidor sobe.
